rules_version = '2';

// Only a signed-in user can read or write their own folder: users/{their user id}/...
// Anyone else, including people who find the website, gets nothing.
//
// STRONGER LOCK (do this after you create your account):
// replace  request.auth.uid == userId
// with     request.auth.uid == userId && userId == "PASTE_YOUR_USER_ID"
// using the User ID from the app's Settings. Then only your one account can ever use the database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
