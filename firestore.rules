rules_version = '2';

// Every member can read and write only their own folder: users/{their user id}/...
// The owner (you) can also READ members' folders for the Members console, except Money (expenses).
// Nobody else, including people who find the website, gets anything.
//
// SET UP: replace PASTE_OWNER_USER_ID below with your User ID
// (Life Tracker → Settings → Account → Copy my User ID), then publish these rules in
// Firebase console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == "PASTE_OWNER_USER_ID";
    }

    // A member's own data: full access.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Owner: list members and read their settings and profile (name, last active).
    match /users/{userId} {
      allow read: if isOwner();
    }

    // Owner: read members' workouts, sleep, weight, goals and plans. Never their expenses.
    match /users/{userId}/{section}/{docId} {
      allow read: if isOwner() && section != 'expenses';
    }
  }
}
